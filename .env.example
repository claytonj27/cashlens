# CashLens environment reference (sanitized; committed on purpose)
#
# This root file is documentation only: it lists the credentials the
# planned integrations will need. Each service loads its own file:
#   apps/web/.env.local    (see apps/web/.env.example; API_ORIGIN)
#   services/api/.env      (see services/api/.env.example; APP_ENV, LOG_LEVEL, ...)
# Real .env files at any depth are git-ignored; only .env.example files
# are tracked. Nothing below is needed for milestone 1.
#
# Rules
# - Never commit real values. Leave placeholders empty here.
# - Never use a NEXT_PUBLIC_ prefix for privileged keys. Anything with that
#   prefix is shipped to the browser.
# - Privileged keys (service role, database password, OpenAI, OpenRouter)
#   belong only in server-side hosting settings and local server .env files.
# - No model identifiers are assumed yet; select and record them during
#   scaffolding and the deployment spike.

# ---------------------------------------------------------------------------
# Supabase (Auth, Postgres, private Storage)
# ---------------------------------------------------------------------------
# Project URL. Not secret, but keep the browser copy separate (see below).
SUPABASE_URL=
# Anonymous/public key. Only safe for the browser when Row Level Security
# and Storage policies are enforced and tested.
SUPABASE_ANON_KEY=
# Service role key. Bypasses RLS. Server-side only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for migrations and server queries.
# Server-side only.
SUPABASE_DB_URL=
# Private Storage bucket name for uploaded statements.
SUPABASE_STORAGE_BUCKET=

# Browser-safe public configuration (decided during scaffolding).
# Only non-privileged values may ever carry this prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# OpenAI (direct, server-side; used for private statement processing)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Model ID chosen from models available to the account at implementation time.
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# OpenRouter (optional; synthetic-data evaluations only, after imports work)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | preview | production. Keep preview analytics separate.
APP_ENV=
# Frontend-to-API routing target; confirmed during the deployment spike.
API_BASE_URL=
# Server-enforced model spend and processing limits; values set at scaffolding.
AI_USAGE_BUDGET=
IMPORT_MAX_FILE_BYTES=
IMPORT_MAX_PDF_PAGES=
IMPORT_MAX_CSV_ROWS=
