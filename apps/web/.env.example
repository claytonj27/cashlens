# CashLens web local configuration. Copy to apps/web/.env.local (git-ignored).
#
# Loading: Next.js reads .env.local for `npm run dev` and `npm run start`.
# API_ORIGIN and API_PROTECTION_BYPASS are read by src/proxy.ts at request
# time, server-side only. The NEXT_PUBLIC_ values are compiled into the
# browser bundle on purpose: the Supabase publishable key is designed for
# browsers, and row security decides what it can read.

# Origin of the CashLens API that /api/* requests are forwarded to. Origin
# only, no /api suffix. Unset locally = http://127.0.0.1:8000. Required on
# Vercel, where it is set per environment in the project settings.
API_ORIGIN=

# Vercel deployment-protection bypass secret for the API project. Sent as a
# request header by the server-side proxy so the protected API accepts this
# app's requests. Only needed on Vercel; leave empty locally.
API_PROTECTION_BYPASS=

# Supabase Auth in the browser: project URL and the publishable (anon) key.
# Never put a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Traffic analytics. Both must be set for the Google tag to load at all; it is deliberately off
# in local development and in automated checks. The measurement id is not a secret: it ships in
# the client bundle by design. Nothing is collected until a visitor agrees.
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Mirrors the API's PUBLIC_DEMO_ONLY so the interface stops offering accounts, sign-in and
# uploads. The API is the authority; this only avoids advertising a door that is not there.
# It also enables the demo on its own: nothing in the demo path signs in, so a synthetic-only
# deployment needs no NEXT_PUBLIC_SUPABASE_* values at all.
NEXT_PUBLIC_PUBLIC_DEMO_ONLY=

# Reviewer mode for the Discovery portal: local question-quality notes kept in this browser's
# localStorage, never sent anywhere. Off unless "true". On a non-production build `?review=1`
# in the URL switches it on without this. Never set on a deployment.
NEXT_PUBLIC_DISCOVERY_REVIEW_MODE=
